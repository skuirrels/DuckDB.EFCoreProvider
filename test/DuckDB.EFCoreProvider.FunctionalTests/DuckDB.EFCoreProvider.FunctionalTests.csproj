<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <OutputType Condition="'$(TargetFramework)' == 'net11.0'">Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>DuckDB.EFCoreProvider.FunctionalTests</AssemblyName>
    <RootNamespace>Microsoft.EntityFrameworkCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      EF Core relational specification fixtures share a backing store per StoreName
      (e.g. the Filters and non-Filters inheritance bulk-update fixtures both use
      "TPCInheritanceBulkUpdatesTest"). DuckDB opens such a shared file as a single
      in-process database with MVCC, so running those classes in parallel produces
      "TransactionContext Error: Conflict on update!". Disable collection
      parallelization, matching EF Core's own relational test projects.
    -->
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DuckDB.EFCoreProvider.NTS\DuckDB.EFCoreProvider.NTS.csproj" />
    <ProjectReference Include="..\..\src\DuckDB.EFCoreProvider\DuckDB.EFCoreProvider.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="AwesomeAssertions.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="pengdows.crud.fakeDb" PrivateAssets="all" />
    <!-- Match EF's test infrastructure packages; upstream override data is inherited at runtime. -->
    <PackageReference Include="xunit.v3.core.mtp-off" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="xunit.v3.assert" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="xunit.assert" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="xunit.core" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="xunit.extensibility.core" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="xunit.runner.console" Condition="'$(TargetFramework)' == 'net10.0'">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="JunitXml.TestLogger" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="EFCoreVersion" Value="$(EFCoreVersion)" />
    <AssemblyMetadata Include="TestTargetFramework" Value="$(TargetFramework)" />
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
        Include="TestData/DuckLake/v03.db.gz.b64"
        LogicalName="DuckDB.EFCoreProvider.FunctionalTests.TestData.DuckLake.v03.db.gz.b64" />
  </ItemGroup>

</Project>
